# Copy to client/.env.local and fill in to enable. All client env vars must be
# prefixed with VITE_ to be exposed to the build.
#   cp client/.env.example client/.env.local

# Sentry error tracking for the browser. Leave blank to disable (no-op).
# From https://sentry.io → your project → Settings → Client Keys (DSN).
VITE_SENTRY_DSN=
