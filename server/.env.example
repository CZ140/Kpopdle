# Copy this file to server/.env and fill in the values.
#   cp server/.env.example server/.env

# --- Core ---------------------------------------------------------------
# Daily song selection. Any random string — generate with: openssl rand -hex 32
DAILY_SONG_SECRET=replace-with-output-of-openssl-rand-hex-32

# Signs session cookies AND salts the IP hashing in request telemetry.
# Must be secret in production — the default makes hashed IPs reversible.
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

PORT=3001
NODE_ENV=development

# --- Admin dashboard (/admin) -------------------------------------------
# Comma-separated Google account emails allowed into the analytics dashboard.
ADMIN_EMAILS=you@example.com

# --- Persistence (production) -------------------------------------------
# Directory for the SQLite database (stats + telemetry + sessions + users).
# In production point this at a persistent volume so data survives redeploys.
# Leave blank in development to use server/src/data/.
DB_PATH=

# --- Google OAuth (sign-in) ---------------------------------------------
# From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Base URL of the client, used for post-login redirects.
CLIENT_URL=http://localhost:3000

# --- Observability (optional) -------------------------------------------
# Structured-log level: trace|debug|info|warn|error (default: info).
LOG_LEVEL=info
# Sentry error tracking. Leave blank to disable entirely (no-op).
# From https://sentry.io → your project → Settings → Client Keys (DSN).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
